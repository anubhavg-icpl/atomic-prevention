# Atomic Prevention runtime
MA_HOST=127.0.0.1
MA_PORT=3000
MA_DEBUG=false
MA_CORS_ORIGINS='["http://localhost:3000"]'

# Optional Claude analysis. Keep disabled until the key is supplied securely.
MA_CLAUDE_ENABLED=false
MA_ANTHROPIC_API_KEY=
MA_ANTHROPIC_MODEL=claude-sonnet-4-5
MA_ANTHROPIC_VERSION=2023-06-01
MA_ANTHROPIC_MAX_TOKENS=6000

# Optional GitLab issue automation
MA_GITLAB_ENABLED=false
MA_GITLAB_URL=https://gitlab.invinsense.dev
MA_GITLAB_TOKEN=
MA_GITLAB_DEFAULT_PROJECT=infopercept/xdr/uec/uec
MA_GITLAB_AUTO_CREATE_ISSUES=false
MA_GITLAB_AUTO_ISSUE_MODE=finding

# Optional UEC correlation. Username/password login is supported for the
# development tenant; prefer a token where available.
MA_UEC_ENABLED=false
MA_UEC_BASE_URL=https://platform-dev.invinsense.dev/xdr/uec
MA_UEC_TENANT=default
MA_UEC_TOKEN=
MA_UEC_USERNAME=
MA_UEC_PASSWORD=
MA_UEC_CORRELATION_ENABLED=true
MA_UEC_MATCH_GRACE_SECONDS=180
